# Contact remains disabled until separate activation approval.
CONTACT_ENABLED=false
CONTACT_RECIPIENT_CONFIRMED=false
CONTACT_PRIVACY_REVIEWED=false
# Must match VERCEL_ENV (preview/production), or development outside Vercel.
CONTACT_DEPLOYMENT_ENV=
# Exact HTTPS origin; no path/trailing slash; separate for each deployment environment.
CONTACT_ORIGIN=
# Dedicated commercial credentials, entered directly in the authorized server environment.
CONTACT_RESEND_API_KEY=
# Single authorized, verified sender mailbox; no display-name syntax.
CONTACT_FROM=
# Fixed recipient, only after explicit commercial-use confirmation.
CONTACT_TO=
# Public site key is exposed only when the whole configuration is ready.
CONTACT_TURNSTILE_SITE_KEY=
CONTACT_TURNSTILE_SECRET_KEY=

# Optional public mailto alternative; separate approval to expose the confirmed recipient.
CONTACT_MAILTO_ENABLED=false
